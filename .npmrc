# Use a flat (hoisted) node_modules layout.
#
# pnpm normally links packages with symlinks/junctions. Some Windows setups
# (and sandboxed CI environments) do not follow those links for Node's module
# resolution, which makes `next build` fail with "Cannot find module
# 'styled-jsx/package.json'". A hoisted layout is portable and behaves like npm.
node-linker=hoisted

# Keep the install deterministic for the whole team.
auto-install-peers=true
strict-peer-dependencies=false
