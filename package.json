{
  "name": "wasl",
  "version": "1.0.0",
  "private": true,
  "description": "Wasl - Blood Donation and Coordination Platform for Karachi",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit",
    "test": "node tests/run-all.ts",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.ts",
    "db:seed": "node --env-file-if-exists=.env.local scripts/seed.ts",
    "db:reset": "node --env-file-if-exists=.env.local scripts/reset.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.15",
    "next": "15.5.29",
    "pg": "8.23.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "24.0.10",
    "@types/pg": "8.15.5",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "autoprefixer": "10.4.21",
    "postcss": "8.5.6",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3"
  }
}
