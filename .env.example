# ------------------------------------------------------------------
# Wasl - environment configuration
# Copy to `.env.local` and fill in. Never commit real secrets.
# ------------------------------------------------------------------

# Data store.
# Leave EMPTY to use the embedded PostgreSQL (PGlite) for local dev - no setup.
# Set to a real PostgreSQL connection string for staging/production, e.g.
#   DATABASE_URL=postgresql://wasl:password@localhost:5432/wasl
DATABASE_URL=

# Directory used by embedded PostgreSQL in local development.
PGLITE_DIR=.data/wasl-pg

# Sessions use random per-login tokens stored only as SHA-256 hashes, so no
# signing secret is required. (SESSION_SECRET was removed because nothing read it.)

# Initial administrator account, created by `pnpm db:seed`.
ADMIN_EMAIL=admin@wasl.pk
ADMIN_PHONE=+923000000000
ADMIN_PASSWORD=WaslAdmin#2026
ADMIN_NAME=Wasl Administrator

# One-time passcode lifetime (seconds) and resend cooldown (seconds).
OTP_TTL_SECONDS=300
OTP_RESEND_SECONDS=60
OTP_MAX_ATTEMPTS=5

# Session inactivity timeout (minutes) - NFR-SEC-02
SESSION_IDLE_MINUTES=30

# Login lockout - NFR-SEC-02
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15

# SMS provider. Leave empty to use the development provider, which writes
# messages to the Dev Outbox instead of sending them.
SMS_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Set to "production" on a real deployment.
NODE_ENV=development
